# Windows runs .bat files most reliably with Windows line endings, and Mac and Linux need
# Unix line endings in their launchers
*.bat text eol=crlf
*.command text eol=lf
*.sh text eol=lf

# Test fixtures are checked byte for byte (one starts with a UTF-8 BOM, as CSTimer writes it),
# so git must never change their line endings
tests/fixtures/** -text

# Only needed for working on the app, so they're left out of the ZIP that GitHub builds for
# "Download ZIP" and releases (the download INSTALLATION.md points people to). They stay in
# the repository, so the tests still run on GitHub and anyone who clones it has them.
tests/ export-ignore
.github/ export-ignore
tools/ export-ignore
# The phone app is used from its website, not the download
pwa/ export-ignore
.gitattributes export-ignore
.gitignore export-ignore
